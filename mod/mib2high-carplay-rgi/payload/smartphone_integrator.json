        "decoderRestartTimeout":10000,
        "cleanupTimeout":2500,
        "deviceRemovalDelay":750,
        "customerUpdateName":"SmartphoneIntegration",
        "customerUpdatePartition":"/mnt/app",
        "reportListWithoutCheck":true,
        "restartAfterUpdate":true,
        "swdlFiles":[]
     },
     "flags":{
