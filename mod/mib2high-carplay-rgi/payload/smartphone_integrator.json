            "ignoredDeviceClasses":["0x09:*","0x08:*"],
            "galUnsupportedProductIDs":["0x0fca:*"],
            "mirrorlinkUnsupportedProductIDs":[],
            "carplayUnsupportedProductIDs":[],
            "dsrcCardReader":{
                "deviceAddress":1,
                "portNumber":2
            },
            "oldMediaConnector":"0x0424:0x4040",
			"newMediaConnector":"0x0424:0x2530",
			"bridgePortOldMediaConnector":1,
			"forcePowerResetOldConnector":false,
			"powerEnableScript":"/etc/scripts/enable_usb_pwr_0.sh",
			"powerDisableScript":"/etc/scripts/disable_usb_pwr_0.sh",
			"powerDelayTimeHostMode":1000,
			"powerDelayTimeDeviceMode":1000,
			"otgStackReconnectTimeout":30000,
			"otgStackStartScriptDeviceMode":"/etc/scripts/start_otg_stack_device_mode.sh",
			"otgStackStartScriptHostMode":"/etc/scripts/start_otg_stack_host_mode.sh",
			"otgStackStopScript":"/etc/scripts/stop_otg_stack.sh",
			"otgStackDevicePath":"/dev/io-usb/otg_dev",
			"restartOtgStackDelayTime":5000
      },
    ###########################################################################
    # CHILDREN CONFIGURATION
    ###########################################################################
     "children":{
        "gal":{
            "exec":"gal",
            "path":"/mnt/app/eso/bin/apps",
            "params":"",
            "envs":[
                "LD_LIBRARY_PATH=/eso/lib:/mnt/app/usr/lib:/mnt/app/armle/lib:/mnt/app/armle/lib/dll:/mnt/app/armle/usr/lib:/mnt/app/root/lib-target",
                "IPL_CONFIG_DIR_GAL=/etc/eso/production"
            ],
            "startupTimeout":10000,
            "stopTimeout":6000,
            "watchdogTimeout":60000,
            "disableWatchdog":false,
            "maxSetupRetries":2,
            "maxRuntimeRetries":2,
            "decoderUse":true,
            "selfTermination":true,
            "cleanupScript":"",
            "skipDeviceTest":false
        },
        "mirrorlink":{
            "exec":"mirrorlink.real",
            "path":"/mnt/app/eso/bin/apps",
            "params":"",
            "envs":[
                "LIBIMG_CFGFILE=/etc/imgprocessing.cfg",
                "LD_PRELOAD=/eso/lib/libsystemtime_hack.so",
                "LD_LIBRARY_PATH=/lib:/mnt/app/root/lib-target:/eso/lib:/mnt/app/usr/lib:/mnt/app/armle/lib:/mnt/app/armle/lib/dll:/mnt/app/armle/usr/lib",
                "IPL_CONFIG_DIR_MIRRORLINK=/etc/eso/production"
            ],
            "startupTimeout":60000,
            "stopTimeout":3000,
            "watchdogTimeout":60000,
            "disableWatchdog":false,
            "maxSetupRetries":2,
            "maxRuntimeRetries":0,
            "decoderUse":false,
            "selfTermination":false,
            "cleanupScript":"",
            "skipDeviceTest":true
        },
        "carplay":{
            "exec":"dio_manager",
            "path":"/mnt/app/eso/bin/apps",
            "params":"",
